{
  "opencollection": "1.0.0",
  "info": {
    "name": "Microsoft Graph API (Azure AD) Applications Me API",
    "version": "v1.0"
  },
  "items": [
    {
      "info": {
        "name": "Me",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get the signed-in user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://graph.microsoft.com/v1.0/me",
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://login.microsoftonline.com/common/oauth2/v2.0/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Get the signed-in user"
        },
        {
          "info": {
            "name": "Get the signed-in user's profile photo",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://graph.microsoft.com/v1.0/me/photo/$value",
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://login.microsoftonline.com/common/oauth2/v2.0/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Get the signed-in user's profile photo"
        }
      ]
    }
  ],
  "bundled": true
}